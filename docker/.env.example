# ==========================================
# Dify 特色端口配置 - 避免本地和线上冲突
# ==========================================

# ==========================================
# 主要服务端口 - 使用特色端口号
# ==========================================
# Nginx 端口 - 使用 Dify 特色端口
EXPOSE_NGINX_PORT=5001
EXPOSE_NGINX_SSL_PORT=5002
NGINX_PORT=80
NGINX_SSL_PORT=443

# ==========================================
# 数据库和缓存端口 - 避免常用端口
# ==========================================
# PostgreSQL - 使用特色端口
EXPOSE_POSTGRES_PORT=5433
# Redis - 使用特色端口
EXPOSE_REDIS_PORT=6381

# ==========================================
# 向量数据库端口 - 特色配置
# ==========================================
# Weaviate - 特色端口
EXPOSE_WEAVIATE_PORT=8081

# OceanBase - 特色端口
OCEANBASE_VECTOR_PORT=2882

# OpenGauss - 特色端口
OPENGAUSS_PORT=6601

# MyScale - 特色端口
MYSCALE_PORT=8124

# MatrixOne - 特色端口
MATRIXONE_PORT=6002

# Elasticsearch - 特色端口
ELASTICSEARCH_PORT=9201
KIBANA_PORT=5602

# ==========================================
# 其他服务端口 - 特色配置
# ==========================================
# Sandbox - 特色端口
EXPOSE_SANDBOX_PORT=8195

# SSRF Proxy - 特色端口
EXPOSE_SSRF_PROXY_PORT=3129

# Plugin Daemon - 特色端口
EXPOSE_PLUGIN_DAEMON_PORT=5003
EXPOSE_PLUGIN_DEBUGGING_PORT=5004

# ==========================================
# 硬编码端口修改建议
# ==========================================
# Milvus 端口建议修改为：
# - 19531:19530 (原 19530:19530)
# - 9092:9091 (原 9091:9091)

# Vastbase 端口建议修改为：
# - '5435:5432' (原 '5434:5432')

# ==========================================
# 管理员初始化配置
# ==========================================
# 设置初始化密码
INIT_PASSWORD=dify2024

# ==========================================
# 数据库配置
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dify2024
POSTGRES_DB=dify
PGDATA=/var/lib/postgresql/data/pgdata

# Redis配置
REDIS_PASSWORD=dify2024

# ==========================================
# 特色端口说明
# ==========================================
# 5001/5002: Dify 主服务端口 (Dify = 5个字母)
# 5433: PostgreSQL 特色端口
# 6381: Redis 特色端口 (6+3+8+1=18, 1+8=9, 9是幸运数字)
# 8081: Weaviate 特色端口
# 2882: OceanBase 特色端口
# 6601: OpenGauss 特色端口
# 8124: MyScale 特色端口
# 6002: MatrixOne 特色端口
# 9201: Elasticsearch 特色端口
# 5602: Kibana 特色端口
# 8195: Sandbox 特色端口
# 3129: SSRF Proxy 特色端口
# 5003/5004: Plugin 特色端口

# ==========================================
# 使用说明
# ==========================================
# 1. 复制此文件为 .env: cp 特色端口配置.env .env
# 2. 启动服务: docker-compose up -d
# 3. 访问地址: http://your-server-ip:5001
# 4. 初始化页面: http://your-server-ip:5001/init
# 5. 初始化密码: dify2024
