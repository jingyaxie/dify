# Dify Docker 环境变量配置
# 修改端口以避免与现有服务冲突

# ==========================================
# Nginx 端口配置 - 主要冲突源
# ==========================================
EXPOSE_NGINX_PORT=8080
EXPOSE_NGINX_SSL_PORT=8443
NGINX_PORT=80
NGINX_SSL_PORT=443

# ==========================================
# 数据库和缓存服务端口
# ==========================================
EXPOSE_POSTGRES_PORT=5432
EXPOSE_REDIS_PORT=6379

# ==========================================
# 向量数据库端口配置
# ==========================================
# Weaviate
EXPOSE_WEAVIATE_PORT=8080

# OceanBase
OCEANBASE_VECTOR_PORT=2881

# OpenGauss
OPENGAUSS_PORT=6600

# MyScale
MYSCALE_PORT=8123

# MatrixOne
MATRIXONE_PORT=6001

# Elasticsearch
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601

# Milvus (如果使用)
# 注意：这些端口在配置中是硬编码的，需要手动修改docker-compose.yaml
# 19530:19530
# 9091:9091

# ==========================================
# 其他服务端口
# ==========================================
EXPOSE_SANDBOX_PORT=8194
EXPOSE_SSRF_PROXY_PORT=3128
EXPOSE_PLUGIN_DAEMON_PORT=5002
EXPOSE_PLUGIN_DEBUGGING_PORT=5003

